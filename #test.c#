#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <unistd.h>
#define MAXSIZE 2048

struct sockaddr_in addr;
int main(){
  char dst[]= "132.163.96.6";
  int port = 13;
    
  int sockfd, len, con;
  char buf[MAXSIZE];
  len = sizeof(struct sockaddr_in);
  if((sockfd = socket(AF_INET, SOCK_STREAM, 0)) < 0){
    puts("Socket error!");
    exit(1);
  }

  addr.sin_family = AF_INET;
  addr.sin_port = htons(port);
  inet_pton(AF_INET, dst, &addr.sin_family);

  if((con = connect(sockfd, (struct sockaddr *)&addr, len)) < 0){
    puts("Connection error!");
    exit(1);
  }
  while(con){
    if(read(sockfd, buf, MAXSIZE) < 0){
      puts("Reading failure");
      exit(1);
    }
    fputs(buf, stdout);
  }
  exit(0);
	  




}
